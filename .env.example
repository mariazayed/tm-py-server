# Copy this file to .env and fill in real values. Never commit .env.

# --- MetaTrader 5 terminal login ---
# These must match an account you can log into in the MT5 desktop terminal.
# The terminal does NOT need to be manually logged in beforehand if these
# are provided -- the MetaTrader5 package will attempt to log in itself.
# If you leave them blank, the importer will attach to whatever account
# is already logged into the currently-running MT5 terminal instead.
MT5_LOGIN=118265
MT5_PASSWORD='CVGDgbdfgeRT%T%$RETytrr43ewreFr4#EWER2345'
MT5_SERVER=CGInvest-Server
# Optional: full path to terminal64.exe if MT5 isn't installed in the
# default location and auto-detection fails.
MT5_TERMINAL_PATH='C:\Program Files\CGFX MT5 Terminal\terminal64.exe'

# --- TradeMind backend API ---
TM_API_BASE_URL=http://localhost:8080
# If/when the API requires auth, put a bearer token here and it will be
# sent as "Authorization: Bearer <token>". Leave blank if not needed yet.
TM_API_TOKEN=

# --- Behavior toggles (can be overridden by CLI flags, see README) ---
# Earliest date to look back to when reconstructing account balance
# history for accountBalanceAtEntry (only used with --reconstruct-balance).
# Format: YYYY-MM-DD. Should be a date you are CERTAIN predates the
# account's real inception / first deposit.
ACCOUNT_HISTORY_START=2020-01-01
